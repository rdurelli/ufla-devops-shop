# Variáveis de Ambiente para a Stack Completa
# Gere uma senha forte para o banco de dados e coloque aqui
POSTGRES_PASSWORD=minhasenhaforte123

# A URL do banco é montada usando a senha acima.
# O hostname 'banco' corresponde ao nome do serviço no compose.yaml
DATABASE_URL=postgresql://${POSTGRES_PASSWORD}@banco:5432/postgres

# O hostname 'cache' corresponde ao nome do serviço no compose.yaml
REDIS_URL=redis://cache:6379/0
