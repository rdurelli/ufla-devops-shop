# Template de segredos do ufla-devops-shop.
#
# O deploy.sh instala este arquivo em /etc/ufla-shop.env.example e, na primeira
# execucao, gera /etc/ufla-shop.env a partir daqui trocando CHANGE-ME por uma
# senha aleatoria. Nunca versione a senha real: ela fica so em /etc/ufla-shop.env.
#
# IMPORTANTE: mantenha a senha sem os caracteres @ : # — ela vai dentro da URL
# e de comandos SQL no deploy.sh.
DATABASE_URL=postgresql://loja:CHANGE-ME@localhost:5432/loja
REDIS_URL=redis://localhost:6379/0
