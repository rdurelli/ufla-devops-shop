[Unit]
Description=API do ufla-devops-shop
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ufla-devops-shop
Environment="PORT=8000"
EnvironmentFile=-/etc/ufla-devops-shop.env
ExecStart=/opt/ufla-devops-shop/.venv/bin/uvicorn app:api --host 127.0.0.1 --port ${PORT}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=512M

[Install]
WantedBy=multi-user.target
